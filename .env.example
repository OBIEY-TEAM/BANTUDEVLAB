# BANTUDEVLAB — Environnement de Configuration Souverain

# Django
DEBUG=True
DJANGO_SECRET_KEY=bantudevlab-sovereign-production-key-change-me
ALLOWED_HOSTS=localhost,127.0.0.1,systalink.cloud,bantudevlab.africa

# Base de Données PostgreSQL
DB_ENGINE=postgres
POSTGRES_DB=bantudevlab
POSTGRES_USER=bantudevlab_admin
POSTGRES_PASSWORD=sovereign_pass_2025
POSTGRES_HOST=db
