# BANTUDEVLAB - Environnement de configuration souverain
# Copiez ce fichier en `.env` puis REMPLACEZ toutes les valeurs CHANGE_ME.
# Ne committez jamais le fichier `.env`.

# --- Django ---
# Production : DEBUG=False (valeur par defaut). Developpement local : DEBUG=True.
DEBUG=False
# Generer : python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=CHANGE_ME
ALLOWED_HOSTS=localhost,127.0.0.1
# Origines HTTPS de confiance (production), separees par des virgules
CSRF_TRUSTED_ORIGINS=
# Mettre False uniquement derriere un reverse proxy qui gere deja la redirection HTTPS
SECURE_SSL_REDIRECT=True

# --- Base de donnees PostgreSQL ---
DB_ENGINE=postgres
POSTGRES_DB=bantudevlab
POSTGRES_USER=bantudevlab_admin
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Gitea Sovereign Engine ---
GITEA_API_URL=http://gitea:3000/api/v1
GITEA_EXTERNAL_URL=http://localhost:3002
GITEA_ADMIN_TOKEN=
# Obligatoire pour activer le webhook (sinon il repond 503). Generer comme DJANGO_SECRET_KEY.
GITEA_WEBHOOK_SECRET=CHANGE_ME

# --- Gemma 2 2B Local AI Engine (Ollama / vLLM / TGI) ---
GEMMA_API_URL=http://localhost:11434/api/generate
GEMMA_MODEL_NAME=gemma2:2b

# --- Redis & Celery ---
REDIS_PASSWORD=CHANGE_ME
