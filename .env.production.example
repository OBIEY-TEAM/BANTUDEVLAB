# BANTUDEVLAB — Configuration Environnement de Production (Systalink Cloud Tier-3)
# ATTENTION : Ne jamais commiter de secrets en clair dans le dépôt Git

DEBUG=False
DJANGO_SECRET_KEY=generate_strong_64_chars_secret_key_here_for_production
# Domaines et URLs de Base Souverains
BASE_URL_1=https://cybersocle.site
BASE_URL_2=https://git.cybersocle.site
BASE_URL_3=https://api.cybersocle.site

ALLOWED_HOSTS=cybersocle.site,git.cybersocle.site,api.cybersocle.site,bantudevlab.africa,git.bantudevlab.africa,api.bantudevlab.africa,127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=https://cybersocle.site,https://git.cybersocle.site,https://api.cybersocle.site,https://bantudevlab.africa,http://localhost:8001,http://127.0.0.1:8001

# Base de Données PostgreSQL Managée Haute Disponibilité
DB_ENGINE=postgres
POSTGRES_DB=bantudevlab_prod
POSTGRES_USER=bantudevlab_admin
POSTGRES_PASSWORD=use_vault_or_strong_random_db_password_here
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Cache & File de Messages Distribuée (Redis 7)
REDIS_PASSWORD=use_strong_redis_auth_token_here
REDIS_URL=redis://:use_strong_redis_auth_token_here@redis:6379/0
CELERY_BROKER_URL=redis://:use_strong_redis_auth_token_here@redis:6379/0
CELERY_RESULT_BACKEND=redis://:use_strong_redis_auth_token_here@redis:6379/0

# Moteur de Forge Gitea & GitLab CE Souverain rattaché à https://git.cybersocle.site
GITLAB_URL=https://git.cybersocle.site
GITLAB_PRIVATE_TOKEN=production_gitlab_admin_token_here
GITLAB_WEBHOOK_SECRET=production_gitlab_webhook_hmac_secret_here
GITEA_WEB_URL=https://git.cybersocle.site
GITEA_EXTERNAL_URL=https://git.cybersocle.site
GITEA_LOGIN_URL=https://git.cybersocle.site/user/login
GITEA_API_URL=http://gitea:3000/api/v1

# Moteur d'Inférence IA Locale (Gemma 2 2B - Offline / Datacenter Local)
GEMMA_API_URL=http://ollama:11434/api/generate
GEMMA_MODEL_NAME=gemma2:2b

# Paramètres Sécurité Réseau & TLS
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
