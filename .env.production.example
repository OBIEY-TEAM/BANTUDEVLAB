# BANTUDEVLAB — Configuration Environnement de Production (Systalink Cloud Tier-3)
# ATTENTION : Ne jamais commiter de secrets en clair dans le dépôt Git

DEBUG=False
DJANGO_SECRET_KEY=generate_strong_64_chars_secret_key_here_for_production
ALLOWED_HOSTS=bantudevlab.africa,git.bantudevlab.africa,api.bantudevlab.africa,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://bantudevlab.africa,https://git.bantudevlab.africa,https://api.bantudevlab.africa

# Base de Données PostgreSQL Managée Haute Disponibilité
DB_ENGINE=postgres
POSTGRES_DB=bantudevlab_production
POSTGRES_USER=bantudevlab_secuser
POSTGRES_PASSWORD=use_vault_or_strong_random_db_password_here
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Cache & File de Messages Distribuée (Redis 7)
REDIS_PASSWORD=use_strong_redis_auth_token_here
REDIS_URL=redis://:use_strong_redis_auth_token_here@redis:6379/0
CELERY_BROKER_URL=redis://:use_strong_redis_auth_token_here@redis:6379/0
CELERY_RESULT_BACKEND=redis://:use_strong_redis_auth_token_here@redis:6379/0

# Moteur de Forge GitLab CE / EE Souverain
GITLAB_URL=http://localhost:3001
GITLAB_PRIVATE_TOKEN=production_gitlab_admin_token_here
GITLAB_WEBHOOK_SECRET=production_gitlab_webhook_hmac_secret_here

# Moteur d'Inférence IA Locale (Gemma 5B - Offline / Datacenter Local)
GEMMA_API_URL=http://host.docker.internal:11434/api/generate
GEMMA_MODEL_NAME=gemma:5b

# Paramètres Sécurité Réseau & TLS
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
