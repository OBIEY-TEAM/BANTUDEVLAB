<!-- BANTUDEVLAB - GitHub Style Code Viewer Toolbar (T-UI-602) -->
<div class="file-view-header" style="display: flex; justify-content: space-between; align-items: center; padding: 8px 16px; background-color: var(--color-canvas-subtle, #f6f8fa); border: 1px solid var(--color-border-default, #d0d7de); border-top-left-radius: 6px; border-top-right-radius: 6px; margin-bottom: -1px; font-size: 13px;">
  <div style="display: flex; align-items: center; gap: 8px; font-weight: 500;">
    <span>{{.FileSize}}</span>
    <span style="color: var(--color-text-light, #656d76);">|</span>
    <span>{{.NumLines}} lignes</span>
  </div>
  <div class="file-actions" style="display: flex; gap: 6px;">
    <a class="ui tiny compact button" href="{{.RawFileLink}}" target="_blank" rel="noopener noreferrer">Raw</a>
    <a class="ui tiny compact button" href="{{.RepoLink}}/blame/{{.BranchNameSubURL}}/{{EscapePound .TreePath}}">Blame</a>
    <a class="ui tiny compact button" href="{{.RepoLink}}/commits/{{.BranchNameSubURL}}/{{EscapePound .TreePath}}">History</a>
    {{if .CanEditFile}}
    <a class="ui tiny compact button" href="{{.RepoLink}}/_edit/{{.BranchNameSubURL}}/{{EscapePound .TreePath}}" title="Modifier ce fichier (raccourci 'e')">
      <svg height="14" viewBox="0 0 16 16" width="14" fill="currentColor" style="vertical-align: text-bottom; margin-right: 4px;"><path d="M11.013 1.427a1.75 1.75 0 0 1 2.474 0l1.086 1.086a1.75 1.75 0 0 1 0 2.474l-8.61 8.61c-.21.21-.47.364-.756.445l-3.251.93a.75.75 0 0 1-.927-.928l.929-3.25c.081-.286.235-.547.445-.758l8.61-8.61Zm1.414 1.06a.25.25 0 0 0-.354 0L10.811 3.75l1.439 1.44 1.263-1.263a.25.25 0 0 0 0-.354l-1.086-1.086ZM11.189 6.25 9.75 4.81l-6.286 6.287a.25.25 0 0 0-.064.108l-.558 1.953 1.953-.558a.249.249 0 0 0 .108-.064l6.286-6.286Z"></path></svg>
      Edit
    </a>
    {{end}}
  </div>
</div>

<script>
// Shortcut 'e' to edit currently viewed file
document.addEventListener('keydown', function(e) {
  if (e.key === 'e' && !['INPUT', 'TEXTAREA'].includes(document.activeElement.tagName)) {
    const editBtn = document.querySelector('.file-actions a[href*="/_edit/"]');
    if (editBtn) {
      e.preventDefault();
      window.location.href = editBtn.href;
    }
  }
});
</script>
