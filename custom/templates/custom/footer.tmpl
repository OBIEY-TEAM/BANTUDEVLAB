}
.copilot-action-btn:hover {
  border-color: #00e5ff;
  color: #00e5ff;
}
[data-theme="light"] .copilot-action-btn {
  background: #ffffff;
  color: #0f172a;
  border-color: #cbd5e1;
}

#copilot-messages {
  flex: 1;
  padding: 12px;
  overflow-y: auto;
  font-size: 12px;
  color: #f8fafc;
  line-height: 1.5;
  background: #070e1e;
  display: flex;
  flex-direction: column;
  gap: 8px;
}
[data-theme="light"] #copilot-messages {
