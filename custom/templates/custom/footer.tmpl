  border-color: #e2e8f0;
}

.copilot-msg-user {
  background: #0070f3;
  color: #ffffff;
  padding: 8px 12px;
  border-radius: 8px;
  align-self: flex-end;
  max-width: 90%;
  word-break: break-word;
}

#copilot-input-bar {
  padding: 10px;
  border-top: 1px solid #1e293b;
  background: #020617;
  display: flex;
  gap: 6px;
}
[data-theme="light"] #copilot-input-bar {
  background: #f8fafc;
  border-color: #e2e8f0;
}

#copilot-input {
  flex: 1;
  font-size: 12px;
  background: #0b1528;
  color: #f8fafc;
  border: 1px solid #1e293b;
  border-radius: 6px;
  padding: 6px 10px;
  outline: none;
}
[data-theme="light"] #copilot-input {
  background: #ffffff;
  color: #0f172a;
  border-color: #cbd5e1;
}

#copilot-send-btn {
  background: #10b981;
  color: #ffffff;
  border: none;
  border-radius: 6px;
  padding: 6px 12px;
  font-size: 12px;
  font-weight: 600;
  cursor: pointer;
}
#copilot-send-btn:hover {
  background: #059669;
}
</style>

