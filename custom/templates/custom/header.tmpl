  html[data-theme="dark"] .repo-header-container,
  html[data-theme="dark"] .file-view-header,
  html[data-theme="dark"] .page-footer,
  html:not([data-theme="light"]) .repo-header-container,
  html:not([data-theme="light"]) .file-view-header,
  html:not([data-theme="light"]) .page-footer {
    background-color: #070e1e !important;
    border-color: #1e293b !important;
  }
  html[data-theme="light"],
  html[data-theme="light"] body,
  html[data-theme="light"] .full.height,
  html[data-theme="light"] #wrapper,
  html[data-theme="light"] .page-content,
