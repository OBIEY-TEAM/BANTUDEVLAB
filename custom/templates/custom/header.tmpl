<script>
(function() {
  function getCookie(name) {
    const m = document.cookie.match(new RegExp('(?:^|;\\s*)' + name + '=([^;]*)'));
    return m ? decodeURIComponent(m[1]) : null;
  }
  let isDark = true;
  try {
    const lsTheme = localStorage.getItem('bantu_theme');
    const bantuCookie = getCookie('bantu_theme');
    const giteaTheme = getCookie('theme') || getCookie('gitea_theme');

    if (lsTheme === 'light' || bantuCookie === 'light' || (giteaTheme && giteaTheme === 'github')) {
      isDark = false;
    } else if (lsTheme === 'dark' || bantuCookie === 'dark' || (giteaTheme && giteaTheme.includes('dark'))) {
      isDark = true;
    } else {
      isDark = true;
    }
  } catch(e) {
    isDark = true;
  }

  const themeMode = isDark ? 'dark' : 'light';
  document.documentElement.setAttribute('data-theme', themeMode);

  // Instant update of critical anti-fouc styling
  const antiFouc = document.getElementById('bantu-anti-fouc-critical');
  if (antiFouc) {
    const bgBody = isDark ? '#020617' : '#ffffff';
    const colorBody = isDark ? '#f8fafc' : '#0f172a';
    antiFouc.innerHTML = 'html, body, .full.height, #wrapper, .page-content { background-color: ' + bgBody + ' !important; color: ' + colorBody + ' !important; }';
  }

  // Ensure theme CSS link is synced immediately
  function syncThemeLink() {
    const link = document.querySelector('link[rel="stylesheet"][href*="theme-"]');
    if (link) {
      const target = isDark ? 'theme-github-dark.css' : 'theme-github.css';
      if (!link.href.includes(target)) {
        link.href = link.href.replace(/theme-[a-zA-Z0-9_-]+\.css/, target);
      }
    }
  }
  syncThemeLink();
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', syncThemeLink);
  }
})();
</script>

